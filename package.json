{
  "name": "da1me",
  "devDependencies": {
    "esmify": "^2.1.1",
    "standard": "*"
  },
  "scripts": {
    "build": "npm run build:corpus && npm run build:js",
    "build:corpus": "node scripts/buildCorpus.js",
    "build:js": "npx browserify src/index.js -p esmify > scripts/bundle.js",
    "test": "node tests/stats.test.mjs",
    "dev": "nodemon app.js --exec 'standard && npm run build:js && node'",
    "fixme": "standard --fix"
  },
  "dependencies": {
    "browserify": "^17.0.1",
    "firebase": "^9.22.1",
    "jquery": "^3.7.1",
    "wordcloud": "^1.2.2"
  },
  "standard": {
    "ignore": [
      "**/bundle.js",
      "scripts/bundle.js",
      "**/*_ok.js",
      "**/*.py",
      "**/hinos/*"
    ]
  }
}
