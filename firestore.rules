rules_version = '2';

// Favourites and notes are private to each account. A user may only touch the
// document keyed by their own uid, and nothing else in the database exists.
//
// Publish with:  firebase deploy --only firestore:rules
// or paste into the Firebase console under Firestore Database -> Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
